# Copie para .env.local e preencha. Nunca envie o .env.local ao GitHub.

# Supabase > Project Settings > Data API (URL) e API Keys
NEXT_PUBLIC_SUPABASE_URL=https://COLE_AQUI.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=COLE_AQUI
SUPABASE_SECRET_KEY=COLE_AQUI

# Supabase > Connect > Session pooler (troque [YOUR-PASSWORD] pela senha do banco)
# Usada só pelos scripts npm run db:migrate e db:seed.
DATABASE_URL=COLE_AQUI

# Senha das contas de demonstração (aluno e gestor). Gerada automaticamente.
DEMO_PASSWORD=COLE_AQUI

# Resend > API Keys
RESEND_API_KEY=
EMAIL_FROM=Nexo Agenda <onboarding@resend.dev>
# Sem domínio próprio verificado, o Resend só entrega para o e-mail da sua conta.
# Com esta variável, todo e-mail vai para esse endereço, com o destinatário original no assunto.
EMAIL_TEST_RECIPIENT=
