# Copie para .env.local e preencha. Nunca envie o .env.local ao GitHub.

# Supabase > Project Settings > Data API (URL) e API Keys
NEXT_PUBLIC_SUPABASE_URL=https://COLE_AQUI.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=COLE_AQUI
SUPABASE_SECRET_KEY=COLE_AQUI

# Supabase > Connect > Session pooler (troque [YOUR-PASSWORD] pela senha do banco)
# Usada só pelos scripts npm run db:migrate e db:seed.
DATABASE_URL=COLE_AQUI

# Senha das contas de demonstração (aluno e gestor). Gerada automaticamente.
DEMO_PASSWORD=COLE_AQUI

# --- Envio de e-mail: use o Brevo OU o Resend ---

# Brevo (recomendado sem domínio próprio): entrega no e-mail de cada usuário,
# bastando verificar o endereço remetente em Brevo > Senders.
# A chave fica em Brevo > SMTP & API > API keys.
BREVO_API_KEY=
EMAIL_FROM=Nexo Agenda <seu-email@gmail.com>

# Resend: exige domínio próprio verificado para entregar a qualquer pessoa.
# Sem domínio, só entrega no e-mail da conta; EMAIL_TEST_RECIPIENT manda tudo
# para esse endereço, com o destinatário original no assunto.
# Usado apenas quando BREVO_API_KEY está vazia.
RESEND_API_KEY=
EMAIL_TEST_RECIPIENT=
